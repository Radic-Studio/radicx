{
  "name": "radicx",
  "version": "0.1.0",
  "private": true,
  "description": "RadicX V1 engineering foundation",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "node scripts/lint.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node --test tests/*.test.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run scan:secrets && npm run build"
  }
}
