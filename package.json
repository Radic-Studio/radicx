{
  "name": "radicx",
  "version": "0.2.0",
  "private": true,
  "description": "RadicX V1 engineering foundation",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "node scripts/lint.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node --test tests/*.test.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --local --level warning",
    "db:types": "supabase gen types typescript --local --schema public,storage > supabase/types/database.generated.ts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run scan:secrets && npm run build"
  }
}
